# ========================================================
# baysaass Studio OS & Portfolio Environment Variables
# ========================================================

# App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --------------------------------------------------------
# 0. Admin Authentication
# --------------------------------------------------------
# Master password to access the /admin panel (e.g. baysaass2026!)
ADMIN_PASSWORD=baysaass2026!
ADMIN_SESSION_SECRET=baysaass_studio_os_secure_salt_2026

# --------------------------------------------------------
# 1. Telegram Bot Notification Integration
# --------------------------------------------------------
# 1. Create a bot via @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN
# 2. Get your personal Chat ID from @userinfobot to get your TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --------------------------------------------------------
# 2. TypeSafe AI (Jev System One Engine)
# --------------------------------------------------------
# Used for calibrated semantic gates: Noul (sufficiency), Choice (classification), Score (aesthetic)
TYPESAFE_API_KEY=

# --------------------------------------------------------
# 3. OpenAI (Conversational Generation)
# --------------------------------------------------------
# Used for natural conversational responses in the AI Brief Assistant
OPENAI_API_KEY=

# --------------------------------------------------------
# 4. Email (Resend)
# --------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=baysaauskhuu@gmail.com

# --------------------------------------------------------
# 5. Cloudflare D1 & R2 (Production Database & Storage)
# --------------------------------------------------------
# When omitted, Studio OS uses the local resilient JSON store at data/studio-store.json
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=baysaass
